{% assign widths = include.widths | default: '320,640,960' | split: ',' %}
<img
  src="{{ '/assets/img/home/' | append: include.name | append: '-640.jpg' | relative_url }}"
  srcset="{% for width in widths %}{{ '/assets/img/home/' | append: include.name | append: '-' | append: width | append: '.jpg' | relative_url }} {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
  sizes="{{ include.sizes | default: '(max-width: 480px) calc(100vw - 30px), (max-width: 917px) calc((100vw - 54px) / 2), (max-width: 1000px) calc((100vw - 78px) / 3), 308px' }}"
  width="{{ include.width }}"
  height="{{ include.height }}"
  alt="{{ include.alt | escape }}"
  loading="{{ include.loading | default: 'lazy' }}"
  {% if include.loading == 'eager' %}
    fetchpriority="high"
  {% endif %}
>
