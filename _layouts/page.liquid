---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% unless page.permalink == '/' %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% endunless %}

  {% if page.permalink != '/' and page.section_nav != false %}
    <nav class="section-jump-nav" aria-label="Subsections on this page"></nav>
  {% endif %}

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

{% if page.permalink != '/' and page.section_nav != false %}
  <script src="{{ '/assets/js/section-jump-nav.js' | relative_url }}" defer></script>
{% endif %}
